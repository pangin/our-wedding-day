VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=
VITE_CLOUDINARY_CLOUD_NAME=
# Kakao Developers JavaScript app key. Used by Kakao 지도 SDK and 카카오 로그인 SDK 양쪽.
# Register the deployed domain (e.g. https://pangin.github.io, http://localhost:5173) at
# "플랫폼 > Web" 사이트 도메인 so the SDK accepts the request.
# Kakao 로그인은 이 키로 popup 인증을 띄우고 id_token 을 발급받아 Supabase signInWithIdToken
# 으로 세션을 만든다. Kakao Developers Console 의 "카카오 로그인 > 보안 > OpenID Connect"
# 를 반드시 활성화해야 id_token 이 발급됨.
VITE_KAKAO_MAP_KEY=

# 네이버 로그인 — 네이버 개발자센터(https://developers.naver.com)에서 발급한 Client ID.
# Edge Function 측 시크릿: NAVER_CLIENT_ID + NAVER_CLIENT_SECRET (supabase secrets set 으로).
VITE_NAVER_CLIENT_ID=

# 로그인 제공자 활성화 토글 (선택). 'false' 면 빌드 시 해당 버튼/콜백이 제거된다.
# 빈 값이나 미설정이면 활성 상태로 동작한다.
VITE_AUTH_KAKAO_ENABLED=
VITE_AUTH_GOOGLE_ENABLED=
VITE_AUTH_NAVER_ENABLED=

# RSVP 마감 강제 잠금 (선택). 'true' 로 두면 마감일 전이라도 RSVP 폼이 잠긴 상태로 빌드된다.
# 보통은 GitHub Actions 빌드 단계에서 RSVP_FORCE_CLOSED / RSVP_DEADLINE_UTC 시크릿을 보고
# 자동 결정하므로 로컬에서는 비워두면 된다.
VITE_RSVP_CLOSED=

# 청첩장 전체 닫기 (선택). 'true' 면 예식 후 감사 인사 한 페이지만 남기고
# 사진·계좌·방명록·오시는 길·네비게이션을 모두 숨긴다. 미설정/빈 값이면 청첩장 전체가 열림.
# GitHub Actions 시크릿 VITE_INVITATION_CLOSED 로 코드 수정 없이 열고 닫는다.
VITE_INVITATION_CLOSED=

# Supabase Edge Function secrets, set with:
# supabase secrets set TURNSTILE_SECRET_KEY=...   (omit to disable Turnstile entirely)
# supabase secrets set GOOGLE_CLOUD_NL_API_KEY=...
# supabase secrets set NAVER_CLIENT_ID=...
# supabase secrets set NAVER_CLIENT_SECRET=...
